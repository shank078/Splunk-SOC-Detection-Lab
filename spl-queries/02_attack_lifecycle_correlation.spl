# =============================================================================
# CORRELATION: Brute-Force -> Account Lockout Lifecycle
# =============================================================================
# Author      : Shankar Baral
# Purpose     : Correlate failed login attempts (4625) with the resulting
#               account lockout event (4740) to reconstruct the full attack
#               narrative on a single timeline.
# Data Source : WinEventLog:Security
# Event Codes : 4625 (Failed Login), 4740 (Account Locked)
# MITRE ATT&CK: T1110.001 - Password Guessing
# -----------------------------------------------------------------------------
# Use Case    : Demonstrates how attackers can cause self-inflicted Denial of
#               Service by triggering account lockouts on legitimate users.
# =============================================================================

index=* sourcetype="WinEventLog:Security" (EventCode=4625 OR EventCode=4740)
| eval Status=if(EventCode==4625, "Failed Login", "Account Locked")
| table _time, Status, Account_Name, Source_Network_Address, ComputerName
| sort - _time